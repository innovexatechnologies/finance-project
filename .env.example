# ==============================================================================
# CAMPUSCONNECT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Supply these values with Flutter's --dart-define flags when running or building.
# Example: flutter run -d chrome --dart-define=SUPABASE_URL=https://your-project-id.supabase.co --dart-define=SUPABASE_ANON_KEY=your-anon-key-here
# ==============================================================================

# Supabase Project URL (Required for cloud sync)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (Required for cloud sync)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api -> Project API Keys -> anon public
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Publishable Key (alternative alias for SUPABASE_ANON_KEY)
SUPABASE_PUBLISHABLE_KEY=
