# Supabase Anonymous Public API Key (Required for cloud sync)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api -> Project API Keys -> anon public
SUPABASE_ANON_KEY=sb_publishable_yX1bnVB7y-nFzhelfJhjw_otuDqRlJ

# Optional: Supabase Publishable Key (alternative alias for SUPABASE_ANON_KEY)
